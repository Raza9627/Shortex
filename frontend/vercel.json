{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shortex-backend.vercel.app/api/:path*"
    },
    {
      "source": "/:shortCode([A-Za-z0-9]{6})",
      "destination": "https://shortex-backend.vercel.app/:shortCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}